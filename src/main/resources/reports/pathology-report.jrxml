<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="pathology-report"
        pageWidth="595"
        pageHeight="842"
        columnWidth="535"
        leftMargin="30"
        rightMargin="30"
        topMargin="25"
        bottomMargin="25"
        whenNoDataType="NoDataSection"
        uuid="7c9f2f50-6e3a-4c11-8d5a-111111111111">


    <!-- ========================================================= -->
    <!-- PARAMETERS                                                -->
    <!-- ========================================================= -->

    <parameter name="patientName" class="java.lang.String"/>
    <parameter name="sex" class="java.lang.String"/>
    <parameter name="referenceNo" class="java.lang.String"/>
    <parameter name="referredBy" class="java.lang.String"/>
    <parameter name="age" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>


    <!-- ========================================================= -->
    <!-- FIELDS                                                    -->
    <!-- ========================================================= -->

    <field name="sectionName" class="java.lang.String"/>
    <field name="testName" class="java.lang.String"/>
    <field name="resultValue" class="java.lang.String"/>
    <field name="unit" class="java.lang.String"/>
    <field name="normalRange" class="java.lang.String"/>
    <field name="displayOrder" class="java.lang.Integer"/>


    <!-- ========================================================= -->
    <!-- SECTION GROUP                                             -->
    <!-- ========================================================= -->

    <group name="SectionGroup"
           isStartNewPage="false"
           isReprintHeaderOnEachPage="true">

        <groupExpression>
            <![CDATA[$F{sectionName}]]>
        </groupExpression>


        <!-- ===================================================== -->
        <!-- SECTION + COLUMN HEADERS                              -->
        <!-- ===================================================== -->

        <groupHeader>

            <band height="75">


                <!-- ================================================= -->
                <!-- SECTION NAME                                       -->
                <!-- ================================================= -->

                <textField
                        isBlankWhenNull="true">

                    <reportElement
                            x="0"
                            y="5"
                            width="535"
                            height="24"
                            positionType="Float"/>

                    <textElement
                            textAlignment="Center"
                            verticalAlignment="Middle">

                        <font
                                fontName="Helvetica"
                                size="13"
                                isBold="true"/>

                    </textElement>

                    <textFieldExpression>
                        <![CDATA[$F{sectionName}]]>
                    </textFieldExpression>

                </textField>


                <!-- ================================================= -->
                <!-- TEST HEADER                                        -->
                <!-- ================================================= -->

                <staticText>

                    <reportElement
                            x="40"
                            y="50"
                            width="180"
                            height="20"
                            positionType="Float"/>

                    <textElement
                            textAlignment="Left"
                            verticalAlignment="Middle">

                        <font
                                fontName="Helvetica"
                                size="9"
                                isBold="true"/>

                    </textElement>

                    <text><![CDATA[TEST]]></text>

                </staticText>


                <!-- ================================================= -->
                <!-- RESULT HEADER                                      -->
                <!-- ================================================= -->

                <staticText>

                    <reportElement
                            x="220"
                            y="50"
                            width="80"
                            height="20"
                            positionType="Float"/>

                    <textElement
                            textAlignment="Center"
                            verticalAlignment="Middle">

                        <font
                                fontName="Helvetica"
                                size="9"
                                isBold="true"/>

                    </textElement>

                    <text><![CDATA[RESULT]]></text>

                </staticText>


                <!-- ================================================= -->
                <!-- UNIT HEADER                                        -->
                <!-- ================================================= -->

                <staticText>

                    <reportElement
                            x="300"
                            y="50"
                            width="75"
                            height="20"
                            positionType="Float"/>

                    <textElement
                            textAlignment="Center"
                            verticalAlignment="Middle">

                        <font
                                fontName="Helvetica"
                                size="9"
                                isBold="true"/>

                    </textElement>

                    <text><![CDATA[UNIT]]></text>

                </staticText>


                <!-- ================================================= -->
                <!-- NORMAL RANGE HEADER                                -->
                <!-- ================================================= -->

                <staticText>

